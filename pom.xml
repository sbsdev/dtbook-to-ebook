<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.daisy.pipeline.modules</groupId>
    <artifactId>modules-parent</artifactId>
    <version>1.15.5</version>
    <relativePath />
  </parent>

  <groupId>ch.sbs.pipeline.modules</groupId>
  <artifactId>dtbook-to-ebook</artifactId>
  <version>0.2.0</version>
  <packaging>bundle</packaging>

  <name>DP2 Modules :: SBS DTBook to E-Book</name>
  <description>Converts a DTBook XML document into an EPUB3 e-book using SBS-specific preprocessing.</description>

  <scm>
    <connection>scm:git:https://github.com/sbsdev/dtbook-to-ebook.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/sbsdev/dtbook-to-ebook.git</developerConnection>
    <url>https://github.com/sbsdev/dtbook-to-ebook</url>
    <tag>v0.2.0</tag>
  </scm>

  <build>
    <plugins>
      <!-- mvn release:prepare tags v<version>; the release workflow builds and uploads the deb -->
      <plugin>
        <artifactId>maven-release-plugin</artifactId>
        <version>3.1.1</version>
        <dependencies>
          <!-- the parent pins gitexe 1.9.1, which is incompatible with release plugin 3.x -->
          <dependency>
            <groupId>org.apache.maven.scm</groupId>
            <artifactId>maven-scm-provider-gitexe</artifactId>
            <version>2.1.0</version>
          </dependency>
        </dependencies>
        <configuration>
          <tagNameFormat>v@{project.version}</tagNameFormat>
          <pushChanges>true</pushChanges>
          <!-- the parent activates a Sonatype deploy profile -->
          <arguments combine.self="override" />
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.daisy.pipeline.build</groupId>
        <artifactId>modules-build-helper</artifactId>
        <executions>
          <execution>
            <id>process-test-catalog</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>process-test-catalog</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Debian package that drops the module jar into a stock Pipeline2 installation -->
      <plugin>
        <groupId>org.vafer</groupId>
        <artifactId>jdeb</artifactId>
        <version>1.10</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>jdeb</goal>
            </goals>
            <configuration>
              <controlDir>${basedir}/src/deb/control</controlDir>
              <deb>${project.build.directory}/${project.artifactId}_[[version]]_all.deb</deb>
              <dataSet>
                <data>
                  <src>${project.build.directory}/${project.build.finalName}.jar</src>
                  <type>file</type>
                  <mapper>
                    <type>perm</type>
                    <prefix>/opt/daisy-pipeline2/modules</prefix>
                    <filemode>644</filemode>
                  </mapper>
                </data>
              </dataSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.daisy.pipeline.modules</groupId>
      <artifactId>dtbook-to-epub3</artifactId>
      <version>2.9.0</version>
    </dependency>
    <dependency>
      <groupId>org.daisy.pipeline.modules</groupId>
      <artifactId>common-utils</artifactId>
      <version>3.4.1</version>
    </dependency>
  </dependencies>

</project>
