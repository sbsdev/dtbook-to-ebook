<!-- Old DAISY Pipeline parent poms declare central over http, which Maven >= 3.8
     blocks. Route it to https so the build does not depend on ~/.m2/settings.xml. -->
<settings>
  <mirrors>
    <mirror>
      <id>central-https</id>
      <mirrorOf>central</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
