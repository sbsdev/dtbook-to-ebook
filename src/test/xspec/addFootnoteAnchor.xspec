<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:dtb="http://www.daisy.org/z3986/2005/dtbook/"
               stylesheet="../../main/resources/xml/xslt/addFootnoteAnchor.xsl">

  <x:scenario label="anchor is inserted immediately before noteref">
    <x:context>
      <dtb:p>Text<dtb:noteref idref="#fn1">1</dtb:noteref></dtb:p>
    </x:context>
    <x:expect label="an anchor element precedes the noteref">
      <dtb:p>Text<dtb:a id="noteref_1"/><dtb:noteref idref="#fn1">1</dtb:noteref></dtb:p>
    </x:expect>
  </x:scenario>

  <x:scenario label="anchor ids are numbered sequentially">
    <x:context>
      <dtb:p>
        <dtb:noteref idref="#fn1">1</dtb:noteref>
        <dtb:noteref idref="#fn2">2</dtb:noteref>
      </dtb:p>
    </x:context>
    <x:expect label="first anchor has id noteref_1" test="//dtb:a[1]/@id = 'noteref_1'"/>
    <x:expect label="second anchor has id noteref_2" test="//dtb:a[2]/@id = 'noteref_2'"/>
  </x:scenario>

  <x:scenario label="noteref content and attributes are preserved">
    <x:context>
      <dtb:p><dtb:noteref idref="#fn1">1</dtb:noteref></dtb:p>
    </x:context>
    <x:expect label="noteref idref is unchanged" test="//dtb:noteref/@idref = '#fn1'"/>
    <x:expect label="noteref text content is unchanged" test="//dtb:noteref = '1'"/>
  </x:scenario>

  <x:scenario label="non-noteref elements are copied unchanged">
    <x:context>
      <dtb:p>plain text</dtb:p>
    </x:context>
    <x:expect label="paragraph is unchanged">
      <dtb:p>plain text</dtb:p>
    </x:expect>
  </x:scenario>

</x:description>
