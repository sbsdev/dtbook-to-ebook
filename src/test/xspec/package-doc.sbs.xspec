<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests for the SBS OPF package document post-processing XSLT.
     The context wraps the package document together with the content documents. -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:opf="http://www.idpf.org/2007/opf"
               xmlns:dc="http://purl.org/dc/elements/1.1/"
               xmlns:html="http://www.w3.org/1999/xhtml"
               stylesheet="../../main/resources/xml/xslt/package-doc.sbs.xsl">

  <x:param name="identifier" select="'sbs-uid'"/>

  <x:scenario label="a text-only book">
    <x:context>
      <wrapper>
        <opf:package>
          <opf:metadata>
            <dc:title>Text-only book</dc:title>
            <opf:meta property="schema:accessMode">textual</opf:meta>
            <opf:meta property="schema:accessibilityFeature">tableOfContents</opf:meta>
            <opf:meta property="schema:accessibilityHazard">unknown</opf:meta>
          </opf:metadata>
          <opf:manifest>
            <opf:item media-type="application/xhtml+xml" href="content.xhtml" id="c1"/>
          </opf:manifest>
        </opf:package>
        <html:html><html:body><html:p>Text</html:p></html:body></html:html>
      </wrapper>
    </x:context>
    <x:expect label="the result is the package document"
              test="exists(/opf:package) and empty(//html:*)"/>
    <x:expect label="accessMode textual is present exactly once"
              test="count(//opf:meta[@property='schema:accessMode' and . = 'textual']) = 1"/>
    <x:expect label="accessMode visual is absent"
              test="empty(//opf:meta[@property='schema:accessMode' and . = 'visual'])"/>
    <x:expect label="accessModeSufficient is textual"
              test="//opf:meta[@property='schema:accessModeSufficient'] = 'textual'"/>
    <x:expect label="accessibilityHazard is none and replaces unknown"
              test="string-join(//opf:meta[@property='schema:accessibilityHazard'], ',') = 'none'"/>
    <x:expect label="existing accessibilityFeature values are kept"
              test="//opf:meta[@property='schema:accessibilityFeature'] = 'tableOfContents'"/>
    <x:expect label="alternativeText is absent"
              test="not(//opf:meta[@property='schema:accessibilityFeature'] = 'alternativeText')"/>
    <x:expect label="longDescription is absent"
              test="not(//opf:meta[@property='schema:accessibilityFeature'] = 'longDescription')"/>
    <x:expect label="metadata values are element text, not a content attribute"
              test="empty(//opf:meta[@property]/@content)"/>
  </x:scenario>

  <x:scenario label="leftovers of the intermediate ZedAI">
    <x:context>
      <wrapper>
        <opf:package>
          <opf:metadata>
            <dc:title>Book</dc:title>
            <dc:subject/>
            <dc:description> </dc:description>
            <dc:rights/>
            <dc:format>ANSI/NISO Z39.86-2005</dc:format>
            <opf:link rel="record" href="zedai-mods.xml" media-type="application/mods+xml"/>
          </opf:metadata>
        </opf:package>
      </wrapper>
    </x:context>
    <x:expect label="empty DCMES elements are removed"
              test="empty(//dc:*[not(normalize-space())])"/>
    <x:expect label="dc:format is removed"
              test="empty(//dc:format)"/>
    <x:expect label="the link to the MODS record is removed"
              test="empty(//opf:link[@rel='record'])"/>
    <x:expect label="other metadata is kept"
              test="//dc:title = 'Book'"/>
  </x:scenario>

  <x:scenario label="the source of the page breaks">
    <x:context>
      <wrapper>
        <opf:package>
          <opf:metadata>
            <dc:source>978-3-15-014331-5</dc:source>
            <opf:meta property="a11y:pageBreakSource">978-3-15-014331-5</opf:meta>
          </opf:metadata>
        </opf:package>
      </wrapper>
    </x:context>
    <x:expect label="the prefixed a11y:pageBreakSource is removed"
              test="empty(//opf:meta[@property='a11y:pageBreakSource'])"/>
    <x:expect label="the source of the page breaks uses the EPUB 3.4 pageBreakSource, with the ISBN as URN"
              test="//opf:meta[@property='pageBreakSource'] = 'urn:isbn:9783150143315'"/>
  </x:scenario>

  <x:scenario label="the identifier comes from the DTBook">
    <x:context>
      <wrapper>
        <opf:package unique-identifier="pub-id">
          <opf:metadata>
            <dc:identifier id="pub-id">0f6e3a4c-random-uuid</dc:identifier>
          </opf:metadata>
        </opf:package>
      </wrapper>
    </x:context>
    <x:expect label="the unique identifier is the one passed in, with the id of the guidelines"
              test="/opf:package/@unique-identifier = 'pub-identifier' and //dc:identifier[@id='pub-identifier'] = 'sbs-uid'"/>
  </x:scenario>

  <x:scenario label="a book with described images">
    <x:context>
      <wrapper>
        <opf:package>
          <opf:metadata><dc:title>Book with images</dc:title></opf:metadata>
          <opf:manifest>
            <opf:item media-type="image/jpeg" href="photo.jpg" id="img1"/>
          </opf:manifest>
        </opf:package>
        <html:html><html:body>
          <html:img src="photo.jpg" alt="A photo" aria-describedby="d1"/>
          <html:aside id="d1"><html:p>Description</html:p></html:aside>
        </html:body></html:html>
      </wrapper>
    </x:context>
    <x:expect label="accessMode visual is present"
              test="//opf:meta[@property='schema:accessMode'] = 'visual'"/>
    <x:expect label="alternativeText is present"
              test="//opf:meta[@property='schema:accessibilityFeature'] = 'alternativeText'"/>
    <x:expect label="longDescription is present"
              test="//opf:meta[@property='schema:accessibilityFeature'] = 'longDescription'"/>
  </x:scenario>

  <x:scenario label="a book with images without alt text or description">
    <x:context>
      <wrapper>
        <opf:package>
          <opf:metadata><dc:title>Book with images</dc:title></opf:metadata>
          <opf:manifest>
            <opf:item media-type="image/jpeg" href="photo.jpg" id="img1"/>
          </opf:manifest>
        </opf:package>
        <html:html><html:body><html:img src="photo.jpg" alt=""/></html:body></html:html>
      </wrapper>
    </x:context>
    <x:expect label="alternativeText is absent"
              test="not(//opf:meta[@property='schema:accessibilityFeature'] = 'alternativeText')"/>
    <x:expect label="longDescription is absent"
              test="not(//opf:meta[@property='schema:accessibilityFeature'] = 'longDescription')"/>
  </x:scenario>

  <x:scenario label="the metadata of the Nordic Guidelines">
    <x:context>
      <wrapper>
        <opf:package prefix="dcterms: http://purl.org/dc/terms/" unique-identifier="pub-id">
          <opf:metadata>
            <dc:title id="id_1">Book</dc:title>
            <opf:meta refines="#id_1" property="title-type">main</opf:meta>
            <dc:source>Ein Verlag, 2020</dc:source>
            <opf:meta property="schema:accessibilityFeature">tableOfContents</opf:meta>
            <opf:meta property="schema:accessibilityFeature">pageNavigation</opf:meta>
            <opf:meta property="a11y:pageBreakSource">Ein Verlag, 2020</opf:meta>
          </opf:metadata>
        </opf:package>
      </wrapper>
    </x:context>
    <x:expect label="the nordic prefix is declared"
              test="/opf:package/@prefix = 'dcterms: http://purl.org/dc/terms/ nordic: http://www.mtm.se/epub/'"/>
    <x:expect label="the title has the id of the guidelines"
              test="//dc:title/@id = 'title' and //opf:meta[@property='title-type']/@refines = '#title'"/>
    <x:expect label="the version of the guidelines is given twice"
              test="//opf:meta[@property='nordic:guidelines'] = '2025-1'
                    and //opf:link[@rel='dcterms:conformsTo']/@href = 'https://format.mtm.se/nordic_epub/2025-1'"/>
    <x:expect label="the publication claims conformance with EPUB Accessibility 1.1 and WCAG 2.1 AA"
              test="//opf:meta[@property='dcterms:conformsTo'] = 'EPUB Accessibility 1.1 - WCAG 2.1 Level AA'"/>
    <x:expect label="SBS is supplier and certifier"
              test="//opf:meta[@property='nordic:supplier'] = 'SBS' and //opf:meta[@property='a11y:certifiedBy'] = 'SBS'"/>
    <x:expect label="the features of the guidelines are added once, page break markers with the page navigation"
              test="string-join(//opf:meta[@property='schema:accessibilityFeature'], ',')
                    = 'tableOfContents,pageNavigation,displayTransformability,structuralNavigation,readingOrder,pageBreakMarkers'"/>
    <x:expect label="a page source that is not an ISBN is kept as is"
              test="//opf:meta[@property='pageBreakSource'] = 'Ein Verlag, 2020'"/>
    <x:expect label="there is no accessibility summary"
              test="empty(//opf:meta[@property='schema:accessibilitySummary'])"/>
  </x:scenario>

  <x:scenario label="a book without page numbers">
    <x:context>
      <wrapper>
        <opf:package><opf:metadata><dc:title>Book</dc:title></opf:metadata></opf:package>
      </wrapper>
    </x:context>
    <x:expect label="has no page break markers"
              test="not(//opf:meta[@property='schema:accessibilityFeature'] = 'pageBreakMarkers')"/>
  </x:scenario>

</x:description>
