<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests for the classes required by the Nordic Guidelines 2025-1 ("Pagination", "Title Page") -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:dtb="http://www.daisy.org/z3986/2005/dtbook/"
               stylesheet="../../main/resources/xml/xslt/addClasses.xsl">

  <x:scenario label="page numbers">
    <x:context>
      <dtb:level1>
        <dtb:pagenum id="p1" page="front">i</dtb:pagenum>
        <dtb:pagenum id="p2" page="normal">1</dtb:pagenum>
        <dtb:pagenum id="p3" page="special">A</dtb:pagenum>
        <dtb:pagenum id="p4">2</dtb:pagenum>
        <dtb:pagenum id="p5" class="x">3</dtb:pagenum>
      </dtb:level1>
    </x:context>
    <x:expect label="get the class of their page type, normal by default"
              test="string-join(//dtb:pagenum/@class, ',') = 'page-front,page-normal,page-special,page-normal,x page-normal'"/>
    <x:expect label="keep their number and attributes"
              test="//dtb:pagenum[@id='p1'] = 'i' and //dtb:pagenum[@id='p1']/@page = 'front'"/>
  </x:scenario>

  <x:scenario label="the book title and author">
    <x:context>
      <dtb:book>
        <dtb:frontmatter>
          <dtb:doctitle>Titel</dtb:doctitle>
          <dtb:docauthor class="x">Autorin</dtb:docauthor>
        </dtb:frontmatter>
        <dtb:bodymatter><dtb:level1><dtb:doctitle>Titel im Text</dtb:doctitle></dtb:level1></dtb:bodymatter>
      </dtb:book>
    </x:context>
    <x:expect label="get the classes title and docauthor"
              test="//dtb:frontmatter/dtb:doctitle/@class = 'title' and //dtb:frontmatter/dtb:docauthor/@class = 'x docauthor'"/>
    <x:expect label="only in the frontmatter"
              test="empty(//dtb:bodymatter//@class)"/>
  </x:scenario>

</x:description>
