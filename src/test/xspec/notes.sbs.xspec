<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests for the notes post-processing (Nordic Guidelines 2025-1).
     The context wraps the content document, followed by all content documents.
     Requires catalog resolution of http://www.daisy.org/pipeline/modules/common-utils/i18n.xsl -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:c="http://www.w3.org/ns/xproc-step"
               xmlns:epub="http://www.idpf.org/2007/ops"
               xmlns="http://www.w3.org/1999/xhtml"
               xmlns:h="http://www.w3.org/1999/xhtml"
               stylesheet="../../main/resources/xml/xslt/notes.sbs.xsl">

  <x:scenario label="sequentially numbered notes">
    <x:context>
      <c:wrapper>
        <html xml:lang="de" xml:base="file:/epub/book-2.xhtml"><body>
          <section id="s1">
            <h1>Kapitel</h1>
            <p>Text<a href="#fn1" epub:type="noteref" role="doc-noteref">1</a></p>
            <aside id="fn1"><p>Erste Anmerkung</p></aside>
            <section>
              <h2>Szene</h2>
              <p>Text<a href="#fn2" epub:type="noteref" role="doc-noteref">2</a></p>
              <aside id="fn2"><p>Zweite Anmerkung</p></aside>
            </section>
          </section>
        </body></html>
        <html xml:lang="de" xml:base="file:/epub/book-2.xhtml"><body>
          <section id="s1">
            <h1>Kapitel</h1>
            <p>Text<a href="#fn1" epub:type="noteref" role="doc-noteref">1</a></p>
            <aside id="fn1"><p>Erste Anmerkung</p></aside>
            <section>
              <h2>Szene</h2>
              <p>Text<a href="#fn2" epub:type="noteref" role="doc-noteref">2</a></p>
              <aside id="fn2"><p>Zweite Anmerkung</p></aside>
            </section>
          </section>
        </body></html>
      </c:wrapper>
    </x:context>
    <x:expect label="the result is the content document without xml:base"
              test="exists(/h:html) and empty(/h:html/@xml:base)"/>
    <x:expect label="the note references get an id"
              test="//h:a[@epub:type='noteref']/@id = ('ref-fn1', 'ref-fn2')"/>
    <x:expect label="the notes are no longer in the text"
              test="empty(//h:aside)"/>
    <x:expect label="the endnotes section is the last child of the top-level section"
              test="exists(/h:html/h:body/h:section/*[last()][self::h:section][@role='doc-endnotes'][@epub:type='endnotes'])"/>
    <x:expect label="the endnotes heading is one level below the section heading"
              test="//h:section[@role='doc-endnotes']/h:h2 = 'Anmerkungen'"/>
    <x:expect label="the notes are list items with the note ids"
              test="string-join(//h:section[@role='doc-endnotes']/h:ol/h:li/@id, ',') = 'fn1,fn2'"/>
    <x:expect label="the list starts at 1"
              test="empty(//h:section[@role='doc-endnotes']/h:ol/@start)"/>
    <x:expect label="each note has a backlink with its number in its own paragraph"
              test="//h:li[@id='fn2']/h:p[last()]/h:a[@role='doc-backlink'][@href='#ref-fn2'] = 'Gehe zur Referenz 2.'"/>
    <x:expect label="the note text is kept"
              test="//h:li[@id='fn1']/h:p[1] = 'Erste Anmerkung'"/>
  </x:scenario>

  <x:scenario label="sequential notes that continue the numbering of a previous chapter">
    <x:context>
      <c:wrapper>
        <html xml:lang="de" xml:base="file:/epub/book-3.xhtml"><body>
          <section>
            <h3>Nachwort</h3>
            <p>Text<a href="#fn7" epub:type="noteref">7</a><a href="#fn8" epub:type="noteref">8</a></p>
            <aside id="fn7"><p>Sieben</p></aside>
            <aside id="fn8"><p>Acht</p></aside>
          </section>
        </body></html>
        <html xml:lang="de" xml:base="file:/epub/book-3.xhtml"><body>
          <section>
            <h3>Nachwort</h3>
            <p>Text<a href="#fn7" epub:type="noteref">7</a><a href="#fn8" epub:type="noteref">8</a></p>
            <aside id="fn7"><p>Sieben</p></aside>
            <aside id="fn8"><p>Acht</p></aside>
          </section>
        </body></html>
      </c:wrapper>
    </x:context>
    <x:expect label="the list starts at the first note number"
              test="//h:section[@role='doc-endnotes']/h:ol/@start = '7'"/>
    <x:expect label="the endnotes heading is one level below the section heading"
              test="exists(//h:section[@role='doc-endnotes']/h:h4)"/>
  </x:scenario>

  <x:scenario label="notes that are not numbered sequentially">
    <x:context>
      <c:wrapper>
        <html xml:lang="de" xml:base="file:/epub/book-2.xhtml"><body>
          <section>
            <h1>Kapitel</h1>
            <p>Text<a href="#fn1" epub:type="noteref">*</a></p>
            <aside id="fn1"><p>Stern</p></aside>
          </section>
        </body></html>
        <html xml:lang="de" xml:base="file:/epub/book-2.xhtml"><body>
          <section>
            <h1>Kapitel</h1>
            <p>Text<a href="#fn1" epub:type="noteref">*</a></p>
            <aside id="fn1"><p>Stern</p></aside>
          </section>
        </body></html>
      </c:wrapper>
    </x:context>
    <x:expect label="there is no endnotes section"
              test="empty(//h:section[@role='doc-endnotes'])"/>
    <x:expect label="the note stays in place as a footnote"
              test="exists(/h:html/h:body/h:section/h:aside[@id='fn1'][@role='doc-footnote'][@epub:type='footnote'])"/>
    <x:expect label="the footnote has a backlink"
              test="//h:aside/h:p[last()]/h:a[@role='doc-backlink'][@href='#ref-fn1'] = 'Gehe zur Referenz *.'"/>
  </x:scenario>

  <x:scenario label="a note referenced from another file">
    <x:context>
      <c:wrapper>
        <html xml:lang="de" xml:base="file:/epub/book-3.xhtml"><body>
          <section>
            <h1>Anhang</h1>
            <aside id="fn1"><p>Anmerkung</p></aside>
          </section>
        </body></html>
        <html xml:lang="de" xml:base="file:/epub/book-2.xhtml"><body>
          <section>
            <h1>Kapitel</h1>
            <p>Text<a href="book-3.xhtml#fn1" epub:type="noteref">1</a></p>
          </section>
        </body></html>
        <html xml:lang="de" xml:base="file:/epub/book-3.xhtml"><body>
          <section>
            <h1>Anhang</h1>
            <aside id="fn1"><p>Anmerkung</p></aside>
          </section>
        </body></html>
      </c:wrapper>
    </x:context>
    <x:expect label="the backlink points to the other file"
              test="//h:li[@id='fn1']//h:a[@role='doc-backlink']/@href = 'book-2.xhtml#ref-fn1'"/>
  </x:scenario>

  <x:scenario label="an aside that is not a note">
    <x:context>
      <c:wrapper>
        <html xml:base="file:/epub/book-2.xhtml"><body>
          <section><h1>Kapitel</h1><aside id="box"><p>Kasten</p></aside></section>
        </body></html>
        <html xml:base="file:/epub/book-2.xhtml"><body>
          <section><h1>Kapitel</h1><aside id="box"><p>Kasten</p></aside></section>
        </body></html>
      </c:wrapper>
    </x:context>
    <x:expect label="is left alone"
              test="exists(//h:section/h:aside[@id='box'][empty(@role)]) and empty(//h:a)"/>
  </x:scenario>

  <x:scenario label="Italian">
    <x:context>
      <c:wrapper>
        <html xml:lang="it" xml:base="file:/epub/book-2.xhtml"><body>
          <section><h1>Capitolo</h1><p><a href="#fn1" epub:type="noteref">1</a></p><aside id="fn1"><p>Nota</p></aside></section>
        </body></html>
        <html xml:lang="it" xml:base="file:/epub/book-2.xhtml"><body>
          <section><h1>Capitolo</h1><p><a href="#fn1" epub:type="noteref">1</a></p><aside id="fn1"><p>Nota</p></aside></section>
        </body></html>
      </c:wrapper>
    </x:context>
    <x:expect label="the heading is Italian"
              test="//h:section[@role='doc-endnotes']/h:h2 = 'Note'"/>
    <x:expect label="the backlink is Italian"
              test="//h:a[@role='doc-backlink'] = 'Torna al riferimento 1.'"/>
  </x:scenario>

</x:description>
