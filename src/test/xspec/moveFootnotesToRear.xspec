<?xml version="1.0" encoding="UTF-8"?>
<!-- Requires catalog resolution of http://www.daisy.org/pipeline/modules/common-utils/i18n.xsl -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec"
               xmlns:dtb="http://www.daisy.org/z3986/2005/dtbook/"
               stylesheet="../../main/resources/xml/xslt/moveFootnotesToRear.xsl">

  <x:scenario label="notes are moved into a new level1 in existing rearmatter">
    <x:context>
      <dtb:book>
        <dtb:bodymatter>
          <dtb:level1>
            <dtb:p>Text<dtb:noteref idref="#fn1">1</dtb:noteref></dtb:p>
            <dtb:note id="fn1"><dtb:p>Footnote</dtb:p></dtb:note>
          </dtb:level1>
        </dtb:bodymatter>
        <dtb:rearmatter>
          <dtb:level1><dtb:h1>Bibliography</dtb:h1></dtb:level1>
        </dtb:rearmatter>
      </dtb:book>
    </x:context>
    <x:expect label="note appears in rearmatter"
              test="exists(//dtb:rearmatter//dtb:note)"/>
    <x:expect label="note is removed from bodymatter"
              test="not(//dtb:bodymatter//dtb:note)"/>
    <x:expect label="rearmatter level1 heading is 'Fussnoten'"
              test="//dtb:rearmatter/dtb:level1[last()]/dtb:h1 = 'Fussnoten'"/>
  </x:scenario>

  <x:scenario label="rearmatter is created when the book has none">
    <x:context>
      <dtb:book>
        <dtb:bodymatter>
          <dtb:level1>
            <dtb:p>Text</dtb:p>
            <dtb:note id="fn1"><dtb:p>Footnote</dtb:p></dtb:note>
          </dtb:level1>
        </dtb:bodymatter>
      </dtb:book>
    </x:context>
    <x:expect label="a rearmatter element is created"
              test="exists(//dtb:rearmatter)"/>
    <x:expect label="note appears in rearmatter"
              test="exists(//dtb:rearmatter//dtb:note)"/>
    <x:expect label="note is removed from bodymatter"
              test="not(//dtb:bodymatter//dtb:note)"/>
  </x:scenario>

  <x:scenario label="no rearmatter footnote chapter is added when there are no notes">
    <x:context>
      <dtb:book>
        <dtb:bodymatter>
          <dtb:level1><dtb:h1>Chapter</dtb:h1><dtb:p>Text</dtb:p></dtb:level1>
        </dtb:bodymatter>
        <dtb:rearmatter>
          <dtb:level1><dtb:h1>Index</dtb:h1></dtb:level1>
        </dtb:rearmatter>
      </dtb:book>
    </x:context>
    <x:expect label="rearmatter has exactly one level1"
              test="count(//dtb:rearmatter/dtb:level1) = 1"/>
    <x:expect label="no Fussnoten level1 is added"
              test="not(//dtb:rearmatter/dtb:level1/dtb:h1 = 'Fussnoten')"/>
  </x:scenario>

  <x:scenario label="footnote chapter heading is Italian for Italian documents">
    <x:context>
      <dtb:book xml:lang="it">
        <dtb:bodymatter>
          <dtb:level1>
            <dtb:note id="fn1"><dtb:p>Nota</dtb:p></dtb:note>
          </dtb:level1>
        </dtb:bodymatter>
        <dtb:rearmatter/>
      </dtb:book>
    </x:context>
    <x:expect label="footnote chapter heading is Italian"
              test="//dtb:rearmatter/dtb:level1/dtb:h1 = 'Nota a pie&apos; di pagina'"/>
  </x:scenario>

</x:description>
