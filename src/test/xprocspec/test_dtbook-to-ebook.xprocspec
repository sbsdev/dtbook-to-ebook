<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.daisy.org/ns/xprocspec"
               xmlns:sbs="http://www.sbs.ch/pipeline"
               xmlns:c="http://www.w3.org/ns/xproc-step"
               xmlns:opf="http://www.idpf.org/2007/opf"
               xmlns:dc="http://purl.org/dc/elements/1.1/"
               xmlns:html="http://www.w3.org/1999/xhtml"
               script="dtbook-to-ebook-test-wrapper.xpl">

    <x:scenario label="convert a minimal DTBook to EPUB3">
        <x:call step="sbs:dtbook-to-ebook-test-wrapper">
            <x:input port="source">
                <x:document type="inline" xml:base="minimal.xml">
                    <dtbook xmlns="http://www.daisy.org/z3986/2005/dtbook/"
                            xml:lang="de" version="2005-3">
                        <head>
                            <meta name="dtb:uid" content="sbs-test-uid-12345"/>
                            <meta name="dc:Title" content="Minimal DTBook"/>
                            <meta name="dc:Creator" content="SBS Test"/>
                        </head>
                        <book>
                            <frontmatter>
                                <doctitle>Minimal DTBook</doctitle>
                                <docauthor>SBS Test</docauthor>
                            </frontmatter>
                            <bodymatter>
                                <level1>
                                    <h1>Kapitel 1</h1>
                                    <p>Hallo Welt.</p>
                                </level1>
                            </bodymatter>
                        </book>
                    </dtbook>
                </x:document>
            </x:input>
            <x:option name="output-dir" select="concat($temp-dir,'output/')"/>
            <x:option name="temp-dir" select="concat($temp-dir,'temp/')"/>
        </x:call>

        <x:context label="the output directory">
            <x:document type="directory" base-uri="temp-dir" href="output/"/>
        </x:context>
        <x:expect label="the output directory contains an EPUB file"
                  type="xpath" test="exists(/c:directory/c:file[ends-with(@name, '.epub')])"/>

        <x:context label="the package document">
            <x:document type="port" port="result"/>
        </x:context>
        <x:expect label="the package document has the correct title"
                  type="xpath" test="/opf:package/opf:metadata/dc:title = 'Minimal DTBook'"/>
        <x:expect label="the package document has the DTBook identifier"
                  type="xpath" test="/opf:package/opf:metadata/dc:identifier[@id = /opf:package/@unique-identifier] = 'sbs-test-uid-12345'"/>
        <x:expect label="the package document has the correct language"
                  type="xpath" test="/opf:package/@xml:lang = 'de'"/>
        <x:expect label="the package document declares an accessibility access mode"
                  type="xpath" test="exists(/opf:package/opf:metadata/opf:meta[@property='schema:accessMode'])"/>
        <x:expect label="the SBS post-processing adds accessModeSufficient"
                  type="xpath" test="exists(/opf:package/opf:metadata/opf:meta[@property='schema:accessModeSufficient'])"/>
        <x:expect label="the manifest contains accessibility.css"
                  type="xpath" test="exists(/opf:package/opf:manifest/opf:item[@href='css/accessibility.css'][@media-type='text/css'])"/>

        <x:context label="the first content document">
            <x:document type="port" port="content"/>
        </x:context>
        <x:expect label="the content document links accessibility.css"
                  type="xpath" test="exists(/html:html/html:head/html:link[@rel='stylesheet'][ends-with(@href, 'css/accessibility.css')])"/>

    </x:scenario>

</x:description>
