<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.daisy.org/ns/xprocspec"
               xmlns:sbs="http://www.sbs.ch/pipeline"
               xmlns:c="http://www.w3.org/ns/xproc-step"
               xmlns:opf="http://www.idpf.org/2007/opf"
               xmlns:dc="http://purl.org/dc/elements/1.1/"
               xmlns:html="http://www.w3.org/1999/xhtml"
               xmlns:epub="http://www.idpf.org/2007/ops"
               script="dtbook-to-ebook-test-wrapper.xpl">

    <x:scenario label="convert a minimal DTBook to EPUB3">
        <x:call step="sbs:dtbook-to-ebook-test-wrapper">
            <x:input port="source">
                <x:document type="inline" xml:base="minimal.xml">
                    <dtbook xmlns="http://www.daisy.org/z3986/2005/dtbook/"
                            xml:lang="de" version="2005-3">
                        <head>
                            <meta name="dtb:uid" content="sbs-test-uid-12345"/>
                            <meta name="dc:Title" content="Minimal DTBook"/>
                            <meta name="dc:Creator" content="SBS Test"/>
                        </head>
                        <book>
                            <frontmatter>
                                <doctitle>Minimal DTBook</doctitle>
                                <docauthor>SBS Test</docauthor>
                                <level1 class="titlepage">
                                    <p>Ein Titelblatt</p>
                                </level1>
                            </frontmatter>
                            <bodymatter>
                                <level1>
                                    <h1>Kapitel 1</h1>
                                    <pagenum id="p7" page="normal">7</pagenum>
                                    <p>Hallo Welt.<noteref idref="#n1">1</noteref></p>
                                    <note id="n1"><p>Eine Anmerkung.</p></note>
                                </level1>
                            </bodymatter>
                        </book>
                    </dtbook>
                </x:document>
            </x:input>
            <x:option name="output-dir" select="concat($temp-dir,'output/')"/>
            <x:option name="temp-dir" select="concat($temp-dir,'temp/')"/>
        </x:call>

        <x:context label="the output directory">
            <x:document type="directory" base-uri="temp-dir" href="output/"/>
        </x:context>
        <x:expect label="the output directory contains an EPUB file"
                  type="xpath" test="exists(/c:directory/c:file[ends-with(@name, '.epub')])"/>

        <x:context label="the EPUB">
            <x:document type="zip" base-uri="temp-dir" href="output/minimal.epub"/>
        </x:context>
        <x:expect label="the files are named as required by the Nordic Guidelines"
                  type="xpath" test="every $f in ('EPUB/sbs-test-uid-12345-001-frontmatter.xhtml', 'EPUB/sbs-test-uid-12345-002-chapter.xhtml', 'EPUB/nav.xhtml') satisfies /c:zipfile/c:file/@name = $f"/>
        <x:expect label="the EPUB does not contain the MODS record of the intermediate ZedAI"
                  type="xpath" test="exists(/c:zipfile/c:file) and empty(/c:zipfile/c:file[ends-with(@name, 'zedai-mods.xml')])"/>

        <x:context label="the package document">
            <x:document type="port" port="result"/>
        </x:context>
        <x:expect label="the package document has the correct title"
                  type="xpath" test="/opf:package/opf:metadata/dc:title = 'Minimal DTBook'"/>
        <x:expect label="the package document has the DTBook identifier"
                  type="xpath" test="/opf:package/opf:metadata/dc:identifier[@id = /opf:package/@unique-identifier] = 'sbs-test-uid-12345'"/>
        <x:expect label="the package document has the correct language"
                  type="xpath" test="/opf:package/@xml:lang = 'de'"/>
        <x:expect label="the package document declares an accessibility access mode"
                  type="xpath" test="exists(/opf:package/opf:metadata/opf:meta[@property='schema:accessMode'])"/>
        <x:expect label="the SBS post-processing adds accessModeSufficient"
                  type="xpath" test="exists(/opf:package/opf:metadata/opf:meta[@property='schema:accessModeSufficient'])"/>
        <x:expect label="the manifest contains accessibility.css"
                  type="xpath" test="exists(/opf:package/opf:manifest/opf:item[@href='css/accessibility.css'][@media-type='text/css'])"/>

        <x:context label="the last content document">
            <x:document type="port" port="content"/>
        </x:context>
        <x:expect label="the content document links accessibility.css"
                  type="xpath" test="exists(/html:html/html:head/html:link[@rel='stylesheet'][ends-with(@href, 'css/accessibility.css')])"/>
        <x:expect label="the note is in an endnotes section with a backlink to its reference"
                  type="xpath" test="exists(//html:section[@role='doc-endnotes']/html:ol/html:li[@id = substring-after(//html:a[@role='doc-noteref']/@href, '#')]/html:p/html:a[@role='doc-backlink'][@href = concat('#', //html:a[@role='doc-noteref']/@id)])"/>
        <x:expect label="the page break between blocks has the page number as label and the page class"
                  type="xpath" test="exists(//html:section/html:div[@role='doc-pagebreak'][@aria-label='7'][@class='page-normal'])"/>
        <x:expect label="the chapter section has its semantics and is labelled by its heading"
                  type="xpath" test="exists(/html:html/html:body[empty(@epub:type)]/html:section[@role='doc-chapter'][@epub:type='bodymatter chapter'][@aria-labelledby = html:*[matches(local-name(), '^h[1-6]$')]/@id])"/>

        <x:context label="the first content document">
            <x:document type="file" base-uri="temp-dir" href="output/minimal.epub!/EPUB/sbs-test-uid-12345-001-frontmatter.xhtml"/>
        </x:context>
        <x:expect label="the untitled title page is labelled instead of getting a heading"
                  type="xpath" test="exists(//html:section[@aria-label='Titelseite'][empty(html:h1|html:h2|html:h3)])"/>

        <x:context label="the navigation document">
            <x:document type="file" base-uri="temp-dir" href="output/minimal.epub!/EPUB/nav.xhtml"/>
        </x:context>
        <x:expect label="the table of contents lists the title page with its label"
                  type="xpath" test="exists(//html:nav[@epub:type='toc']//html:a[. = 'Titelseite'])"/>

    </x:scenario>

</x:description>
